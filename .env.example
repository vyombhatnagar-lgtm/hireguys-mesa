# On Vercel: DATABASE_URL is added automatically when you connect a Neon database (Storage tab).
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.8-flash
# Leave blank until checkpoint B-2
RESEND_API_KEY=
RESEND_FROM=Kargo Hiring <onboarding@resend.dev>
# Optional: send every email to this address instead (safety net for testing)
EMAIL_OVERRIDE_TO=
# How many candidates per role get a brief + interview invite
TOP_N=5
